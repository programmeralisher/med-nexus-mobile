# Firebase web app config for the "zeeshan-medical-store" project.
# Copy this file to .env and fill in the real values from the Firebase
# Console (Project settings -> General -> Your apps -> SDK setup and
# configuration). These are NOT secret keys — see the comment in
# src/lib/firebase.ts for why they're still kept out of source control
# via env vars rather than hardcoded.
#
# Vite auto-injects VITE_* env vars into the client bundle (see the
# comment in vite.config.ts), so no extra wiring is needed beyond this file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Deliberately no VITE_FIREBASE_MEASUREMENT_ID: Firebase Analytics is not
# initialized in this app (see src/lib/firebase.ts), so there is nothing
# that would consume it.
